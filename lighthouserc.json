{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm start --port 3100",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3100/",
        "http://localhost:3100/en",
        "http://localhost:3100/produkter",
        "http://localhost:3100/produkter/nacre"
      ],
      "numberOfRuns": 3,
      "settings": {}
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 3200,
            "aggregationMethod": "median-run"
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 200,
            "aggregationMethod": "median-run"
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
