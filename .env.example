# ---------------------------------------------------------------------------
# Server secrets. NEVER prefix with NEXT_PUBLIC_. Set per environment in Vercel.
# ---------------------------------------------------------------------------
# Supabase secret key (sb_secret_…). Server-only: checkout, webhooks, admin.
SUPABASE_SECRET_KEY=

# Stripe (cards, Apple Pay, Google Pay, Klarna)
