# Vipps MobilePay ePayment API
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_MSN=
VIPPS_ENV=test

# Email
RESEND_API_KEY=
EMAIL_FROM="HYAL <ordre@example.com>"

# Rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Bring (shipping quotes + labels)
